# Data and run outputs live inside the project (self-contained) but are NOT tracked by git -
# they're large and reproducible. The folder still carries them on disk when you move/copy it.
# Anchored to the repo root (leading /) so they DON'T match src/pm_foundation/data/ etc.
/data/
/outputs/
/outputs_*/
/submitit/
/logs/
*.sif

# Not in this repository: docs/ holds the paper artifacts (LaTeX, TikZ, mockups), not training code.
/docs/

# Python / tooling
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.DS_Store

# Editors
.vscode/
.idea/

.env
.env.*

**/.codegraph/
/exports/

# Figure outputs are regenerated by figures/*.py; the committed copies live in assets/
/figures/*.png
/figures/*.md
/figures/*.pdf
/figures/*.tex
